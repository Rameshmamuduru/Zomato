pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
        IMAGE_NAME = "ramesh0621/zomato"
        IMAGE_TAG  = "v${BUILD_NUMBER}"
        IMAGE      = "${IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {

        stage ("Clean Workspace") {
            steps { cleanWs() }
        }

        stage ("Git Checkout") {
            steps { git 'https://github.com/Rameshmamuduru/Zomato.git' }
        }

        stage("Sonar Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato
                    '''
                }
            }
        }

        stage("Quality Gate (Soft)") {
            steps {
                script {
                    try {
                        waitForQualityGate()
                    } catch(e) {
                        echo "Sonar failed – continuing"
                    }
                }
            }
        }

        stage("NPM Install") {
            steps { sh "npm install" }
        }

        stage ("Trivy FS Scan") {
            steps {
                sh "trivy fs . > trivy.txt || true"
            }
        }

        stage ("Docker Build") {
            steps {
                sh "docker build -t $IMAGE ."
            }
        }

        stage ("Push Image") {
            steps {
                withDockerRegistry([credentialsId: 'docker', url: 'https://index.docker.io/v1/']) {
                    sh "docker push $IMAGE"
                }
            }
        }

        stage ("Trivy Image Scan") {
            steps {
                sh "trivy image --severity HIGH,CRITICAL $IMAGE || true"
            }
        }

        stage("Update K8s Manifest") {
    steps {
        script {
            // Replace the image in deployment YAML
            sh "sed -i 's|image:.*|image: ${IMAGE}|' Kubernetes/zomato/deployment.yaml"

            // Commit & push the change so ArgoCD sees it
            sh """
            git config user.email "jenkins@example.com"
            git config user.name "jenkins"
            git add Kubernetes/zomato/deployment.yaml
            git commit -m "Update image to ${IMAGE}"
            git push origin HEAD:main
            """
        }
    }
}

}

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.result}",
                body: "Job: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}\nURL: ${env.BUILD_URL}",
                to: 'rameshmamuduru7799@gmail.com',
                attachmentsPattern: 'trivy.txt'
            )
        }
    }
}

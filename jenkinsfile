pipeline {
    agent any

    tools {
        jdk 'jdk17'
        nodejs 'node23'
    }

    environment {
        SCANNER_HOME  = tool 'sonar-scanner'
        IMAGE_NAME    = "ramesh0621/zomato"
        IMAGE_TAG     = "v${BUILD_NUMBER}"
        IMAGE         = "${IMAGE_NAME}:${IMAGE_TAG}"
        ARGOCD_SERVER = "ab36b1de79bae42c3a1779513d7f666a-901428307.ap-south-1.elb.amazonaws.com"
        ARGOCD_USER   = "admin"
        ARGOCD_PASS   = "AHvfN9yXyI9s0Aa6"
        ARGOCD_APP    = "zomato"
    }

    stages {

        stage("Clean Workspace") {
            steps { 
                cleanWs() 
            }
        }

        stage("Git Checkout") {
            steps { 
                git 'https://github.com/Rameshmamuduru/Zomato.git' 
            }
        }

        stage("Sonar Analysis") {
            steps {
                withSonarQubeEnv('sonar-server') {
                    sh '''
                    $SCANNER_HOME/bin/sonar-scanner \
                    -Dsonar.projectName=zomato \
                    -Dsonar.projectKey=zomato
                    '''
                }
            }
        }

        stage("Quality Gate (Soft)") {
            steps {
                script {
                    try {
                        waitForQualityGate()
                    } catch(e) {
                        echo "Sonar failed – continuing"
                    }
                }
            }
        }

        stage("NPM Install") {
            steps { 
                sh "npm install" 
            }
        }

        stage("Trivy FS Scan") {
            steps {
                sh "trivy fs . > trivy.txt || true"
            }
        }

        stage("Docker Build") {
            steps {
                sh "docker build -t $IMAGE ."
            }
        }

        stage("Push Image") {
            steps {
                withDockerRegistry([credentialsId: 'docker', url: 'https://index.docker.io/v1/']) {
                    sh "docker push $IMAGE"
                }
            }
        }

        stage("Trivy Image Scan") {
            steps {
                sh "trivy image --severity HIGH,CRITICAL $IMAGE || true"
            }
        }

        stage("Update K8s Manifest") {
            steps {
                script {
                    sh '''
                    DEPLOY_FILE=Kubernetes/zomato/deployment.yaml
                    if [ -f "$DEPLOY_FILE" ]; then
                        sed -i "s|image:.*|image: ${IMAGE}|" $DEPLOY_FILE
                        git config user.email "jenkins@example.com"
                        git config user.name "jenkins"
                        git add $DEPLOY_FILE
                        git commit -m "Update image to ${IMAGE}" || echo "No changes to commit"
                        git push origin HEAD:main
                    else
                        echo "deployment.yaml not found at $DEPLOY_FILE. Skipping manifest update."
                    fi
                    '''
                }
            }
        }

        stage("ArgoCD Sync") {
            steps {
                script {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh '''
                        # Check if ArgoCD CLI is installed
                        if ! command -v argocd &> /dev/null; then
                            echo "ArgoCD CLI not found. Skipping sync."
                            exit 0
                        fi

                        # Login to ArgoCD
                        argocd login $ARGOCD_SERVER --username $ARGOCD_USER --password $ARGOCD_PASS --insecure

                        # Sync the application safely
                        argocd app sync $ARGOCD_APP --retry-strategy=fast
                        '''
                    }
                }
            }
        }

    } // end of stages

    post {
        always {
            emailext(
                attachLog: true,
                subject: "${currentBuild.result}",
                body: "Job: ${env.JOB_NAME}\nBuild: ${env.BUILD_NUMBER}\nURL: ${env.BUILD_URL}",
                to: 'rameshmamuduru7799@gmail.com',
                attachmentsPattern: 'trivy.txt'
            )
        }
    }

} // end of pipeline
